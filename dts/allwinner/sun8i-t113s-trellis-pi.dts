#include <dt-bindings/interrupt-controller/irq.h>

/dts-v1/;

#include <arm/allwinner/sun8i-t113s.dtsi>

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/leds/common.h>
#include <dt-bindings/pwm/pwm.h>

/ {
    model = "Trellis Pi";
    compatible = "protolux,trellis-pi", "allwinner,sun8i-t113s", "allwinner,sun8i";

    aliases {
      serial1 = &uart1;
      serial3 = &uart3;
      serial4 = &uart4;
      serial5 = &uart5;
      /*
      * Pin MMC controller indices so the on-board storage chip is always
      * mmcblk0 and the ESP32 is always mmcblk1. Without
      * these aliases the Linux MMC core assigns host->index by probe
      * completion order, which races between the two controllers.
      */
      mmc0 = &mmc0;
      mmc1 = &mmc1;
      };

    chosen {
        stdout-path = "serial4:115200n8";
    };

    leds {
        compatible = "gpio-leds";

        led-0 {
            color = <LED_COLOR_ID_GREEN>;
            function = LED_FUNCTION_STATUS;
            gpios = <&pio 3 18 GPIO_ACTIVE_HIGH>; /* PD18 */
            linux,default-trigger = "heartbeat";
        };

        led-1 {
            color = <LED_COLOR_ID_BLUE>;
            function = LED_FUNCTION_INDICATOR;
            gpios = <&pio 3 19 GPIO_ACTIVE_HIGH>; /* PD19 */
        };

        led-2 {
            function = "wlan";
            gpios = <&pio 3 17 GPIO_ACTIVE_HIGH>; /* PD17 */
            linux,default-trigger = "netdev";
        };
    };

    reg_vcc5v: regulator-5v {
        compatible = "regulator-fixed";
        regulator-name = "vcc-5v";
        regulator-min-microvolt = <5000000>;
        regulator-max-microvolt = <5000000>;
        regulator-always-on;
    };

    reg_3v3: regulator-3v3 {
        compatible = "regulator-fixed";
        regulator-name = "vcc-3v3";
        regulator-min-microvolt = <3300000>;
        regulator-max-microvolt = <3300000>;
        vin-supply = <&reg_vcc5v>;
        regulator-always-on;
    };

    reg_vcc_core: regulator-core {
        compatible = "regulator-fixed";
        regulator-name = "vcc-core";
        regulator-min-microvolt = <880000>;
        regulator-max-microvolt = <880000>;
        vin-supply = <&reg_vcc5v>;
        regulator-always-on;
    };

    /* ESP32C6 SDIO reset (EN pin), driven through the kernel's MMC
     * power-sequencing framework rather than a driver-owned GPIO toggle --
     * see ../../esp-hosted (trellis_radio driver)
     * knowledge_base/reset-and-power-sequencing.md for why. mmc-pwrseq-simple
     * is invoked by the MMC core's own mmc_power_up()/mmc_power_off(),
     * correctly serialized with mmc_rescan()/card re-enumeration. */
    reg_esp32_pwrseq: esp32-pwrseq {
        compatible = "mmc-pwrseq-simple";
        reset-gpios = <&pio 3 16 GPIO_ACTIVE_LOW>; /* PD16 = ESP_RESET */
        /* 200ms was the untuned starting value. Raised to 1800ms during the
         * same real-hardware session that found the bus-width=1 fix below
         * (see that comment) -- the firmware's application-level SDIO
         * slave HAL isn't ready to answer CCCR/FBR register access until
         * ~1.1-1.2s after enumeration, so this gives real margin before
         * mmc_rescan() even starts. Whether this delay alone was
         * necessary once bus-width=1 was also in place wasn't isolated
         * (both changed together); kept as a safety margin since it's
         * cheap and clearly can't hurt. */
        post-power-on-delay-ms = <1800>;
    };
};

&cpu0 {
    cpu-supply = <&reg_vcc_core>;
};

&cpu1 {
    cpu-supply = <&reg_vcc_core>;
};

&rtc {
    status = "okay";
};

&dcxo {
    clock-frequency = <24000000>;
};

&wdt {
    status = "okay";
};

&pio {
    vcc-pb-supply = <&reg_3v3>;
    vcc-pc-supply = <&reg_3v3>;
    vcc-pd-supply = <&reg_3v3>;
    vcc-pe-supply = <&reg_3v3>;
    vcc-pf-supply = <&reg_3v3>;
    vcc-pg-supply = <&reg_3v3>;

    gpio-line-names =
        /* PA */
        "","","","","","","","",
        "","","","","","","","",
        "","","","","","","","",
        "","","","","","","","",
        /* PB */
        "","","CAN0_TX","CAN0_RX","UART5_TX","UART5_RX","UART3_TX","UART3_RX",
        "","","","","","","","",
        "","","","","","","","",
        "","","","","","","","",
        /* PC */
        "","","CAN0_SIL","","","","","",
        "","","","","","","","",
        "","","","","","","","",
        "","","","","","","","",
        /* PD */
        "","","","","","","","UART4_TX",
        "UART4_RX","","","","","","ESP_BOOT","",
        "ESP_RESET","LED_GREEN","LED_BLUE","","","","","",
        "","","","","","","","",
        /* PE */
        "","","","","","","","",
        "","","","","","","","",
        "","","","","","","","",
        "","","","","","","","",
        /* PF */
        "","","","","","","","",
        "","","","","","","","",
        "","","","","","","","",
        "","","","","","","","",
        /* PG */
        "MMC1_CLK","MMC1_CMD","MMC1_D0","MMC1_D1","MMC1_D2","MMC1_D3","UART1_TX","UART1_RX",
        "UART1_RTS","","","","","","I2C2_SCL","I2C2_SDA",
        "","","","","","","","",
        "","","","","","","","";

    uart4_pd_pins: uart4-pd-pins {
        pins = "PD7", "PD8";
        function = "uart4";
    };

    /omit-if-no-ref/
    i2c2_pg_pins: i2c2-pg-pins {
        pins = "PG14", "PG15";
        function = "i2c2";
    };

    /omit-if-no-ref/
    uart5_pb_pins: uart5-pb-pins {
        pins = "PB4", "PB5";
        function = "uart5";
    };
};

/* shell */
&uart4 {
    pinctrl-names = "default";
    pinctrl-0 = <&uart4_pd_pins>;
    status = "okay";
};

&mmc0 {
    pinctrl-names = "default";
    pinctrl-0 = <&mmc0_pins>;
    vmmc-supply = <&reg_3v3>;
    disable-wp;
    bus-width = <4>;
    max-frequency = <50000000>;
    non-removable;
    broken-cd;
    no-1-8-v;
    status = "okay";
};

&gpadc {
    status = "okay";
    channel@0 {
        reg = <0>;
    };

};

&usb_otg {
    dr_mode = "peripheral";
    status = "okay";
};

&usbphy {
    status = "okay";
};

&ehci1 {
    status = "okay";
};

&ohci1 {
    status = "okay";
};

&spi0 {
    status = "disabled";
};

&spi1 {
    status = "disabled";
};

&mixer0 {
    status = "disabled";
};

&tcon_top {
    status = "disabled";
};

&tcon_lcd0 {
    status = "disabled";
};

&can0 {
    pinctrl-names = "default";
    pinctrl-0 = <&can0_pins>;
    silent-gpios = <&pio 2 2 GPIO_ACTIVE_HIGH>; /* PC2 */
    status = "okay";
};

&i2c2 {
    pinctrl-names = "default";
    pinctrl-0 = <&i2c2_pg_pins>;
    status = "okay";
};

/* ESP32C6 bootloader/download console + Bluetooth HCI (H4). Shares the
 * ROM-download-capable UART0 on the ESP32C6 side (TXD0/RXD0) so this same
 * wire also serves esptool recovery flashing via ESP_BOOT/ESP_RESET. See
 * ../../esp-hosted (trellis_radio) knowledge_base/bluetooth-uart-transport.md. */
&uart1 {
    pinctrl-names = "default";
    pinctrl-0 = <&uart1_pg6_pins>, <&uart1_pg8_rts_cts_pins>;
    uart-has-rtscts;
    linux,rs485-enabled-at-boot-time;
    rs485-rts-active-high;
    rs485-rts-delay-before-send = <1>;
    rs485-rts-delay-after-send = <1>;
    status = "okay";
};

&uart3 {
    pinctrl-names = "default";
    pinctrl-0 = <&uart3_pb_pins>;
    status = "okay";
};

/* ESP32C6 debug console/logs (IO12 TX / IO5 RX on the ESP32C6 side) --
 * enabled/disabled by the firmware's sdkconfig.defaults vs
 * sdkconfig.defaults.prod, not by switching this UART. */
&uart5 {
    pinctrl-names = "default";
    pinctrl-0 = <&uart5_pb_pins>;
    status = "okay";
};

&mmc1 {
    vmmc-supply = <&reg_3v3>;
    vqmmc-supply = <&reg_3v3>;
    /* 1-bit, not 4-bit: confirmed on real hardware that 4-bit mode's CCCR
     * bus-width-switch CMD52 reliably hangs against this ESP32C6
     * firmware (sdio_enable_func() then gets a hard bus-level ETIMEDOUT
     * on every subsequent CMD52, no matter the clock speed or how long
     * you wait/retry -- see esp-hosted's driver/sdio/esp_sdio.c
     * init_sdio_func() for the host-side half of this story). Schematic
     * review confirmed D0-D3/CMD/CLK pin assignment and pull-ups
     * (R38-R42, 51k) are wired correctly per ESP32C6's fixed SDIO slave
     * IOMUX pins, so this isn't a wiring bug -- something about the
     * 4-bit width-switch handshake itself breaks on this firmware/
     * kernel combination, root cause not yet confirmed. 1-bit mode
     * sidesteps that negotiation entirely; everything downstream
     * (including an independently-negotiated High Speed clock switch)
     * then works immediately and reliably. Trade-off: reduced SDIO
     * throughput. Revisit if 4-bit is ever needed -- a logic analyzer on
     * CMD/D0-D3 during the width switch would settle the real cause
     * directly. */
    bus-width = <1>;
    non-removable;
    broken-cd;
    no-1-8-v;
    mmc-pwrseq = <&reg_esp32_pwrseq>;
    pinctrl-names = "default";
    pinctrl-0 = <&mmc1_pins>;
    status = "okay";

    wifi@1 {
        compatible = "protolux,trellis-radio-sdio";
        reg = <1>;
        boot-gpios = <&pio 3 14 GPIO_ACTIVE_LOW>; /* PD14 = ESP_BOOT, optional */
    };
};

&crypto {
    status = "okay";
};

&pwm {
    status = "disabled";
};
